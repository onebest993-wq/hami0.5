<?xml version="1.0" encoding="utf-8"?>
<!--
    قواعد النسخ لأندرويد ١١ فما دون (API ≤ 30) — `fullBackupContent`.

    مع `allowBackup="false"` هذا الملف معطَّل عملياً؛ يبقى دفاعاً ثانياً: إن رفع
    أحدٌ العَلَم يوماً لأي سبب، تظل بيانات الإضابير مستثناة بدل أن تنكشف صامتة.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
