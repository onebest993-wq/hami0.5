# ============================================================
# Hami Legal — .gitignore
#
# كان هذا الملف فارغاً، فصار .env مُتعقَّباً ومنشوراً، وصارت dist/
# وnode_modules/ على بعد `git add .` واحد من المستودع.
#
# قاعدة الملف: كل ما يُولَّد يُحجَب، وكل ما يُكتب بيد إنسان يُتعقَّب.
# استثناء مقصود: .audit/*baseline*.json وimport-closure-gate.json
# مُتعقَّبة لأن حوارس CI تقرأها كخطّ أساس — حجبها يُعطّل البوّابة.
# ============================================================

# --- أسرار: لا يُتعقَّب أي ملف بيئة إلا القوالب ---
.env
.env.*
hami/.env
!.env.example
!.env.production.example
vercel-import-missing.env
vercel-import*.env
*.pem
*.key
*.keystore
*.jks
google-services.json
GoogleService-Info.plist

# --- اعتماديات ---
node_modules/
.pnp
.pnp.js
.yarn/

# --- مخرجات البناء ---
dist/
dist-hq/
dist-ssr/
build/
out/
.next/
.turbo/
.vite/
*.local

# --- مخرجات مولَّدة بسكربتات المستودع ---
src/app/api/vercelRouteManifest.ts
api/handler.js
code-quality-report.json
src/imports/lawyer-dashboard-error.txt

# --- أدلة تدقيق مؤقتة (خطوط الأساس المُتعقَّبة مستثناة أدناه) ---
.audit/_atomic_*
.audit/execution-inventory.json
.audit/import-closure-report.json
.audit/eslint-temp.json
.audit/tsc-*.txt
.audit/ts7006-*.txt
.audit/phase*-*.txt
.audit/*-run.txt
.audit/*-gate.txt
!.audit/import-closure-gate.json
!.audit/lint-baseline.json
!.audit/test-ratchet-baseline.json
!.audit/ts-nocheck-baseline.json
!.audit/tsc-ratchet-baseline.json

# --- أدوات المحرّر: القواعد تُتعقَّب، المجسّات لا ---
.cursor/*.mjs
.cursor/*.png
.cursor/*.json
.cursor/ui-probe/
!.cursor/rules/
.vercel/
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- أندرويد: المشروع يُتعقَّب (فيه تخصيص شاشة البدء والأيقونات)،
#     ومخرجات gradle لا تُتعقَّب ---
android/build/
android/app/build/
android/.gradle/
android/local.properties
android/captures/
android/.idea/
android/app/release/
android/app/debug/
*.apk
*.aab
*.ap_
*.dex

# --- iOS ---
ios/App/Pods/
ios/App/build/
ios/App/output/
ios/App/App/public/
ios/DerivedData/
xcuserdata/
*.xcworkspace/xcuserdata/

# --- اختبارات ومقاييس ---
playwright-report/
test-results/
blob-report/
playwright/.cache/
coverage/
.nyc_output/
.vitest-cache/
*.lcov

# --- سجلات ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- فضلات محلية خارج المنتج (بحث ألعاب / تنظيف عتاد) ---
resonance_*
slot00*
rgb-cleanup/

# --- نظام التشغيل ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.vercel
.env*
