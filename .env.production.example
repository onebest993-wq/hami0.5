# Hami — Production environment (server + Vite build)
# Copy to hosting secrets / .env.production — NEVER commit real values.
#
# ── Vercel (Project → Settings → Environment Variables) ──
# Production + Preview: set ALL keys below. Redeploy after changes.
# Build-time (Vite): VITE_*  |  Runtime (API routes): no VITE_ prefix
#
# ── Supabase ──
# 1. Dashboard → SQL: run ops under supabase/migrations/ops/ when full db push fails
# 2. Copy URL + anon/publishable + service_role (JWT eyJ… أو sb_secret_…) from API settings
# 3. Create Upstash Redis → paste WIFE_REDIS_REST_URL + WIFE_REDIS_REST_TOKEN
# 4. If a secret was pasted in chat/logs: rotate service_role / sb_secret immediately
#
# Gate (local with .env loaded):
#   npm run gate:wife-production:env -- --prod --live --tests

NODE_ENV=production

# Auth gates. true = the whole shell opens with no login — demo builds only.
# It is checked before VITE_BFF_AUTH, so true here defeats BFF auth below.
VITE_SHELL_AUTH_OPEN=false

# Client (Vite — safe for bundle)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
# مزامنة الإضابير (تنفيذ/دعاوى/ملاحظات) والحفظ السحابي للإعدادات
VITE_ENABLE_CLOUD_SYNC=true
# HttpOnly session — JWT في cookie وليس localStorage (يتطلب SUPABASE_* server-side)
# Vercel/BFF hosts: true. Netlify static (netlify.toml) sets VITE_BFF_AUTH=false —
# shell stays closed via VITE_SHELL_AUTH_OPEN=false; sessions are client-side there.
VITE_BFF_AUTH=true
# بريد الدعم الفني العام → clientEnv.supportEmail (لا تستخدم البريد الإداري هنا)
VITE_APP_SUPPORT_EMAIL=
# واتساب الإدارة (استعادة كلمة المرور — خيار التواصل المباشر)
VITE_SUPPORT_WHATSAPP=
HAMI_SUPPORT_WHATSAPP=
# البريد الإداري الرسمي → clientEnv.masterEmail فقط (ممنوع Hardcode في ملفات الواجهة)
VITE_ADMIN_MASTER_EMAIL=
# خادم — وجهة OTP لمقر القيادة
ADMIN_MASTER_EMAIL=
RESEND_API_KEY=
EMAIL_FROM=
# Proton SMTP (Settings → IMAP/SMTP → token) — HQ 6-digit OTP without Auth mail quota
# EMAIL_SMTP_HOST=smtp.protonmail.ch
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=hami.apps@proton.me
# EMAIL_SMTP_PASS=
# HTTPS only — alternative to Resend/SMTP for HQ 6-digit OTP (mailbox form, not confirm)
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=
# required in production (16+ chars) — HQ OTP fail-closed without it
ADMIN_OTP_PEPPER=
# Lawyer password-reset / email-confirm OTP hashing (16+). Falls back to ADMIN_OTP_PEPPER.
AUTH_OTP_PEPPER=
# WhatsApp Cloud (Meta) — AUTHENTICATION copy-code template preferred
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=
# WHATSAPP_OTP_TEMPLATE_LANG=ar
# Dedicated WhatsApp webhook (EMAIL_WEBHOOK_URL is NOT WhatsApp unless the flag is true)
# WHATSAPP_WEBHOOK_URL=
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_VIA_EMAIL_WEBHOOK=true
ADMIN_UUID=
# صندوق الإشعارات عبر الخادم (list/append) — مفعّل افتراضياً. false يعطّل المزامنة في المتصفح فقط
# VITE_HAMI_NOTIFICATION_SERVER_SYNC=false
# ورقة إشعارات Android الأصلية (Compose) — false = لوحة React
# VITE_NATIVE_NOTIFICATION_SHEET=true
# Web Push (VAPID) — بدونها لا يعمل الاشتراك في المتصفح
# VITE_VAPID_PUBLIC_KEY=BPxxxxxxxx
#
# FCM (Android/iOS — push عند إغلاق التطبيق)
# 1. Firebase Console → Project → Service accounts → Generate new private key
# 2. انسخ JSON كسطر واحد في FCM_SERVICE_ACCOUNT_JSON (server-only)
# 3. انسخ google-services.json.example → android/app/google-services.json واملأ المفاتيح
# FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# VITE_SENTRY_DSN=https://...@sentry.io/PROJECT
# VITE_ENABLE_SENTRY=true
# ضبط DSN يفعّل المراقبة على الأصلي أيضاً — لا إطفاء قسري لحزمة Android.
#
# آثار مقروءة (release يُشتق من package.json عبر scripts/app-release-identity.mjs):
#   1. VITE_SOURCEMAP=true npm run build
#   2. ارفع dist/assets/*.map إلى Sentry بالإصدار من: npm run release:identity
#   3. npm run release:strip-sourcemaps      ← قبل النشر، وguard:dist-secrets يفرضه
# بدونها تصل البلاغات بآثار مُصغَّرة لا تدلّ على سطر.
# يُسقط standard_fonts من النشر (~1.6MB) — الخطوط المدمجة في الملف تكفي غالباً
# VITE_PDF_MINIMAL_ASSETS=true

# Server BFF only — never prefix with VITE_
# Supabase inbox للجرس (بعد migration 027) — false = KV-only على الخادم
SHELL_NOTIFICATIONS_SUPABASE=true
# dual-write KV blob — false افتراضياً عند Supabase (لا تفعّل إلا أثناء migration)
SHELL_NOTIFICATIONS_KV_CACHE=false
# بعد backfill من KV → حذف notifications_${userId} blob
SHELL_NOTIFICATIONS_PURGE_KV_AFTER_BACKFILL=true
# Migrations: 027_lawyer_shell_notifications.sql + 028_lawyer_shell_inbox_rebuild_from_events.sql
# Gate: GET /api/notifications/health → ready:true بعد db push
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
# JWT service_role (كلاسيكي) أو sb_secret_… (مفاتيح Supabase الجديدة) — ليس sb_publishable_
SUPABASE_SERVICE_ROLE_KEY=eyJ..._or_sb_secret_...
SUPABASE_UPLOAD_BUCKET=your-bucket-id

# WIFE distributed stores (required for production)
WIFE_REDIS_REST_URL=https://YOUR.upstash.io
WIFE_REDIS_REST_TOKEN=...

# After staging verifies /api/kv-proxy:
# Fail-closed in Edge code even if unset; keep true for ops clarity / live gate.
WIFE_DISABLE_EDGE_KV_PROXY=true

# Platform admin
ADMIN_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ADMIN_ACCESS_KEY=generate-64-char-random-secret

# HMAC for execution/lawsuit payload_mac (server-only — never VITE_)
HAMI_DOSSIER_PAYLOAD_MAC_SECRET=replace-with-64-hex-secret
HAMI_DOSSIER_PAYLOAD_MAC_ENFORCE=true

# Optional server Sentry for WIFE rejection telemetry
# SENTRY_DSN=https://...@sentry.io/PROJECT

# Optional — GoTrue staging E2E (local/staging only, never production secrets in CI logs)
# WIFE_GOTRUE_STAGING_EMAIL=staging-lawyer@example.invalid
# WIFE_GOTRUE_STAGING_PASSWORD=...
# npm run test:e2e:wife:gotrue-staging

# Readiness report: npm run gate:wife-prod-readiness

# ── مقر القيادة (مشروع Vercel منفصل — ليس مشروع المحامي) ──
# مشروع المحامي العام: لا تضبط المتغيرين. مع VERCEL_ENV تُرفض /api/admin بـ 404.
# مشروع المقر فقط (vercel-hq.json):
#   HAMI_HQ_ALLOW_THIS_DEPLOYMENT=true
#   HAMI_HQ_HOSTS=hami-hq.vercel.app     # إلزامي على مشروع المقر بعد ربط الأصل
# النشر: Build Command = npm run build:hq:vercel ، Output = dist-hq
# أو: npx vercel deploy --local-config vercel-hq.json --prod
# فعّل حماية النشر (كلمة سر / SSO) على مشروع المقر. لا تضع المقر على متاجر الهواتف.
