{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/app/*": ["src/app/*"]
    }
  },
  "include": [
    "vite.config.mts",
    "src/vite-plugins/preferFileOverDirectory.ts",
    "src/app/api/security/wifeSecurityHeaders.ts",
    "src/app/api/security/contentSecurityPolicy.ts"
  ]
}
