{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/app/*": ["./src/app/*"]
    }
  },
  "include": [
    "vite.config.mts",
    "src/vite-plugins/preferFileOverDirectory.ts",
    "src/app/api/security/wifeSecurityHeaders.ts",
    "src/app/api/security/contentSecurityPolicy.ts"
  ]
}
