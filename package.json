{
  "name": "hami-app",
  "version": "10.5.0",
  "description": "Hami Legal System - Iraqi Legal Case Management - V1 Admin Edition",
  "scripts": {
    "dev": "vite",
    "dev:fresh": "vite --force",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:analyze": "vite build --mode analyze",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:run": "vitest run",
    "test:security": "vitest run src/app/api/security/wifeValidator.test.ts src/app/api/security/sanitizer.test.ts src/app/api/security/fileValidator.test.ts src/app/api/upload/route.test.ts src/app/services/server/MalwareScanService.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:run && npm run test:e2e",
    "playwright:install": "playwright install",
    "analyze:file": "ts-node scripts/file-analyzer.ts",
    "batch:process": "ts-node scripts/batch-processor.ts",
    "refactor": "ts-node scripts/smart-refactor.ts",
    "quality:check": "npx tsx scripts/code-quality-check.ts",
    "quality:run": "npx tsx scripts/run-quality-check.ts",
    "build:scripts": "tsc scripts/*.ts --outDir dist/scripts",
    "tools:help": "cat scripts/README.md",
    "tools:test": "ts-node scripts/comprehensive-test.ts",
    "organize:docs": "node scripts/organize-docs.js",
    "report": "cat docs/archive/FINAL_REPORT.md",
    "health:utf8": "node scripts/clean-mojibake.mjs --check",
    "health:security": "node scripts/security-audit.mjs",
    "health": "npm run health:utf8 && npm run health:security && npm run typecheck"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
