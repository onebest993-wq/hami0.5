# Hami Legal System - Environment Variables
# نسخ هذا الملف إلى .env وتعبئة القيم

# Sentry - تتبع الأخطاء (اختياري)
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# في التطوير: kv-proxy معطّل افتراضياً (تخزين محلي) — فعّل فقط عند الحاجة:
# VITE_ENABLE_KV_PROXY=true
# VITE_ENABLE_CLOUD_SYNC=true
# بريد الدعم الفني العام (واجهة المستخدم) — عبر clientEnv.supportEmail:
# VITE_APP_SUPPORT_EMAIL=
# واتساب الإدارة لاستعادة كلمة المرور (يفتح wa.me مباشرة) — أرقام عراقية 07… أو 9647…:
# VITE_SUPPORT_WHATSAPP=9647811102199
# HAMI_SUPPORT_WHATSAPP=9647811102199
# البريد الإداري الرسمي عالي الخطورة — عبر clientEnv.masterEmail فقط (يُمنع Hardcode في UI):
# VITE_ADMIN_MASTER_EMAIL=
# خادم (BFF) — نفس البريد لإرسال OTP لمقر القيادة (لا تعتمد على VITE_ وحده في الإنتاج):
# ADMIN_MASTER_EMAIL=
# Resend لإرسال OTP (ستة أرقام مع حيلة المقر). بديل Proton SMTP أو EMAIL_WEBHOOK_URL=https://...
# RESEND_API_KEY=
# EMAIL_FROM=Hami <hami.apps@proton.me>
# EMAIL_SMTP_HOST=smtp.protonmail.ch
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=hami.apps@proton.me
# EMAIL_SMTP_PASS=
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=
# واتساب لاستعادة كلمة المرور / تأكيد الرمز:
# 1) Meta Cloud — قالب AUTHENTICATION (copy-code) موافق عليه، المتغيّر للرمز في الجسم والزر:
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE=hami_otp
# WHATSAPP_OTP_TEMPLATE_LANG=ar
# 2) أو وسيط HTTPS مخصّص (لا يُعدّ EMAIL_WEBHOOK_URL قناة واتساب إلا بالتصريح):
# WHATSAPP_WEBHOOK_URL=https://...
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_VIA_EMAIL_WEBHOOK=true
# AUTH_OTP_PEPPER=long-random-secret   # إنتاج: 16+ — إن غاب يُستخدم ADMIN_OTP_PEPPER
# ADMIN_OTP_PEPPER=long-random-secret   # إلزامي في الإنتاج (16+ حرف) — بدونها يُرفض OTP لمقر القيادة
# ADMIN_UUID=your-supabase-user-uuid
# بعد تطبيق migration 023 (calendar_tombstones) على Supabase:
# VITE_ENABLE_CALENDAR_TOMBSTONES_CLOUD=true

# Supabase — المفتاح الحديث (sb_publishable_...) من لوحة Supabase
# VITE_SUPABASE_URL=https://xxx.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
# VITE_ENABLE_CLOUD_SYNC=true
# VITE_APP_SUPPORT_EMAIL=
# VITE_ADMIN_MASTER_EMAIL=
#
# روابط استعادة كلمة المرور (محلي/إنتاج) — نفس القيم في Redirect URLs داخل Dashboard:
# SITE_URL=http://127.0.0.1:8080
# PASSWORD_RESET_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
# للإنتاج: SITE_URL=https://your-domain.com

# BFF HttpOnly session — JWT في cookie وليس localStorage (يتطلب SUPABASE_* server-side)
# VITE_BFF_AUTH=true
# عند التفعيل: login/session/refresh يُرجع cryptoWrapCredential في RAM فقط (لتشفير التخزين المحلي)

# ─── WIFE Production (server-side — لا تضع service_role في VITE_*) ───
# NODE_ENV=production
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server/BFF only — never VITE_
# في التطوير بدون هذا المفتاح: المواد تُحفظ محلياً في data/dev-iraqi-laws.json
#
# Upstash Redis — إلزامي للإنتاج (nonce + rate limit + stolen-token موزّع)
# WIFE_REDIS_REST_URL=https://xxx.upstash.io
# WIFE_REDIS_REST_TOKEN=...
#
# Edge kv-proxy is fail-closed in code (410 unless opted in). Production secrets:
# WIFE_DISABLE_EDGE_KV_PROXY=true   # explicit disable (recommended)
# WIFE_DISABLE_EDGE_KV_PROXY=false  # emergency legacy only — never in prod
#
# Storage uploads (Vault / Repository / Forum attachments) — server-side bucket:
# SUPABASE_UPLOAD_BUCKET=make-f09713ba-legal-docs
# Edge function env (Supabase dashboard → Functions → make-server):
# SUPABASE_SERVICE_ROLE_KEY=...
#
# Migrations required (supabase db push):
#   20260423000000_create_wife_nonce_store.sql
#   20260613000000_wife_token_sessions.sql
#   20260613000001_wife_csrf_store.sql
#   20260613000002_wife_storage_bucket_rls.sql
#   20260613000003_audit_logs_rls.sql
#   20260613000004_fix_privileged_roles_and_rls.sql
#
# Platform admin (profiles.role=admin or this UUID):
# ADMIN_UUID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# للتطوير المحلي مع «الدخول كمدير أعلى» (افتراضي dev: admin-uuid-1 إن لم تُحدّد):
# ADMIN_UUID=admin-uuid-1
# Edge honeypot/diagnostics (no default — required in production):
# ADMIN_ACCESS_KEY=generate-a-long-random-secret
# Optional: webhook for WIFE rejection alerts (Slack/Discord/custom SIEM)
# WIFE_SECURITY_WEBHOOK_URL=https://hooks.example.com/wife-security

# Production template: see .env.production.example

# ─── إضبارة التنفيذ / الدعاوى (خادم فقط) ───
# HMAC لعمود payload_mac — لا تضع VITE_ ولا تُدخله للحزمة.
# HAMI_DOSSIER_PAYLOAD_MAC_SECRET=
# HAMI_DOSSIER_PAYLOAD_MAC_ENFORCE=true

# ── مقر القيادة: استضافة منفصلة فقط (vercel-hq.json) ──
# لا تضبط HAMI_HQ_ALLOW_THIS_DEPLOYMENT=true في بيئة المحامي.
# HAMI_HQ_ALLOW_THIS_DEPLOYMENT=true
# HAMI_HQ_HOSTS=hami-hq.vercel.app

# ─── تطوير / تجربة: فتح كل ميزات لوحة المحامي بدون تسجيل Supabase حقيقي ───
# أنشئ .env.local (أو استخدم npm run preview:trial) — لا حاجة لحذف شاشة الدخول من الكود.
# VITE_SHELL_AUTH_OPEN=true
# في التطوير: لا يتخطى توثيق المقر — المنتدى يبقى مغلقاً حتى الاعتماد
# VITE_COMMUNITY_DEV_OPEN=false
# VITE_BFF_AUTH=false
